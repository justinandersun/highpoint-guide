{
  "name": "highpoint-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Highpoint Guide",
  "author": "Justin Anderson",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "predevelop": "if lsof -i :8000 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '\\n\u2716 Port 8000 is already in use -- another dev server is probably still running. Stop it first (Ctrl+C in its terminal), then try again.\\n'; exit 1; fi",
    "develop": "rm -rf .cache && mkdir -p .cache && gatsby develop",
    "prestart": "npm run predevelop",
    "start": "rm -rf .cache && mkdir -p .cache && gatsby develop",
    "build": "rm -rf .cache && mkdir -p .cache && gatsby build",
    "preserve": "if lsof -i :9000 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '\\n\u2716 Port 9000 is already in use -- another serve/preview is probably still running. Stop it first (Ctrl+C in its terminal), then try again.\\n'; exit 1; fi",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "check-links": "node scripts/check-links.js"
  },
  "dependencies": {
    "@mdx-js/mdx": "^1.6.22",
    "@mdx-js/react": "^1.6.22",
    "gatsby": "4.25.8",
    "gatsby-plugin-google-gtag": "^4.16.0",
    "gatsby-plugin-html-attributes": "^1.0.5",
    "gatsby-plugin-image": "^2.5.2",
    "gatsby-plugin-manifest": "^4.16.0",
    "gatsby-plugin-mdx": "^3.5.2",
    "gatsby-plugin-offline": "^5.25.0",
    "gatsby-plugin-react-helmet": "^5.14.0",
    "gatsby-plugin-sharp": "^4.5.2",
    "gatsby-plugin-sitemap": "^5.17.0",
    "gatsby-source-filesystem": "^4.5.2",
    "gatsby-transformer-sharp": "^4.6.0",
    "lmdb": "^3.5.6",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-helmet": "^6.1.0",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "undici": "6.29.1"
  }
}
